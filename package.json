{
  "name": "workspace-pr-review",
  "displayName": "Make Your PR Humanoid",
  "description": "在 Qoder 或 VS Code 中评阅 Git 分支、记录行意见并导出评阅任务。",
  "version": "0.7.1",
  "publisher": "workspace-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanqin-zeng/make-your-pr-humanoid-plugin.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Source Control",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:workspacePrReview.controls",
    "onView:workspacePrReview.files",
    "onView:workspacePrReview.allOpinions",
    "onCommand:workspacePrReview.open",
    "onCommand:workspacePrReview.importClarifications"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configurationDefaults": {
      "diffEditor.wordWrap": "on"
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspacePrReview",
          "title": "分支评阅",
          "icon": "media/review.svg"
        }
      ],
      "panel": [
        {
          "id": "workspacePrReview.opinionsPanel",
          "title": "全部评论",
          "icon": "media/review.svg"
        }
      ]
    },
    "views": {
      "workspacePrReview.opinionsPanel": [
        {
          "id": "workspacePrReview.allOpinions",
          "name": "全部评论"
        }
      ],
      "workspacePrReview": [
        {
          "id": "workspacePrReview.controls",
          "type": "webview",
          "name": "仓库与评阅任务"
        },
        {
          "id": "workspacePrReview.files",
          "name": "变更文件"
        }
      ]
    },
    "commands": [
      {
        "command": "workspacePrReview.open",
        "title": "打开分支评阅",
        "category": "评阅",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "workspacePrReview.showAllOpinions",
        "title": "打开全部评论",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.revealOpinion",
        "title": "在评阅详情查看评论",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.refresh",
        "title": "刷新比较",
        "category": "评阅",
        "icon": "$(refresh)"
      },
      {
        "command": "workspacePrReview.openFile",
        "title": "打开评阅 Diff",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.importClarifications",
        "title": "导入 HTML 评阅的修改澄清",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.openWorkingFile",
        "title": "打开工作树中的文件",
        "category": "评阅",
        "icon": "$(go-to-file)"
      },
      {
        "command": "workspacePrReview.expandFolders",
        "title": "展开所有目录",
        "category": "评阅",
        "icon": "$(expand-all)"
      },
      {
        "command": "workspacePrReview.showFlatFiles",
        "title": "切换为平铺显示",
        "category": "评阅",
        "icon": "$(list-flat)"
      },
      {
        "command": "workspacePrReview.showFileTree",
        "title": "切换为文件树",
        "category": "评阅",
        "icon": "$(list-tree)"
      },
      {
        "command": "workspacePrReview.copyFileName",
        "title": "复制文件名",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.copyFileAbsolute",
        "title": "复制文件绝对路径",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.copyFileRelative",
        "title": "复制文件相对路径",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.copyFolderName",
        "title": "复制目录名",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.copyFolderAbsolute",
        "title": "复制目录绝对路径",
        "category": "评阅"
      },
      {
        "command": "workspacePrReview.copyFolderRelative",
        "title": "复制目录相对路径",
        "category": "评阅"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspacePrReview.expandFolders",
          "when": "view == workspacePrReview.files && !workspacePrReview.flatFiles",
          "group": "navigation@1"
        },
        {
          "command": "workspacePrReview.showFlatFiles",
          "when": "view == workspacePrReview.files && !workspacePrReview.flatFiles",
          "group": "navigation@2"
        },
        {
          "command": "workspacePrReview.showFileTree",
          "when": "view == workspacePrReview.files && workspacePrReview.flatFiles",
          "group": "navigation@2"
        },
        {
          "command": "workspacePrReview.refresh",
          "when": "view == workspacePrReview.files",
          "group": "navigation@3"
        },
        {
          "command": "workspacePrReview.open",
          "when": "view == workspacePrReview.files",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "workspacePrReview.revealOpinion",
          "when": "false"
        },
        {
          "command": "workspacePrReview.openFile",
          "when": "false"
        },
        {
          "command": "workspacePrReview.openWorkingFile",
          "when": "false"
        },
        {
          "command": "workspacePrReview.expandFolders",
          "when": "false"
        },
        {
          "command": "workspacePrReview.showFlatFiles",
          "when": "false"
        },
        {
          "command": "workspacePrReview.showFileTree",
          "when": "false"
        },
        {
          "command": "workspacePrReview.copyFileName",
          "when": "false"
        },
        {
          "command": "workspacePrReview.copyFileAbsolute",
          "when": "false"
        },
        {
          "command": "workspacePrReview.copyFileRelative",
          "when": "false"
        },
        {
          "command": "workspacePrReview.copyFolderName",
          "when": "false"
        },
        {
          "command": "workspacePrReview.copyFolderAbsolute",
          "when": "false"
        },
        {
          "command": "workspacePrReview.copyFolderRelative",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "workspacePrReview.openWorkingFile",
          "when": "view == workspacePrReview.files && viewItem == reviewFile",
          "group": "inline"
        },
        {
          "command": "workspacePrReview.copyFileName",
          "when": "view == workspacePrReview.files && viewItem == reviewFile",
          "group": "6_reviewPath@1"
        },
        {
          "command": "workspacePrReview.copyFileAbsolute",
          "when": "view == workspacePrReview.files && viewItem == reviewFile",
          "group": "6_reviewPath@2"
        },
        {
          "command": "workspacePrReview.copyFileRelative",
          "when": "view == workspacePrReview.files && viewItem == reviewFile",
          "group": "6_reviewPath@3"
        },
        {
          "command": "workspacePrReview.copyFolderName",
          "when": "view == workspacePrReview.files && viewItem == reviewFolder",
          "group": "6_reviewPath@1"
        },
        {
          "command": "workspacePrReview.copyFolderAbsolute",
          "when": "view == workspacePrReview.files && viewItem == reviewFolder",
          "group": "6_reviewPath@2"
        },
        {
          "command": "workspacePrReview.copyFolderRelative",
          "when": "view == workspacePrReview.files && viewItem == reviewFolder",
          "group": "6_reviewPath@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "workspacePrReview.copyFileName",
          "when": "resourceScheme == workspace-pr-review",
          "group": "6_reviewPath@1"
        },
        {
          "command": "workspacePrReview.copyFileAbsolute",
          "when": "resourceScheme == workspace-pr-review",
          "group": "6_reviewPath@2"
        },
        {
          "command": "workspacePrReview.copyFileRelative",
          "when": "resourceScheme == workspace-pr-review",
          "group": "6_reviewPath@3"
        }
      ]
    }
  }
}
